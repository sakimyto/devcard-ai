exports[`renderCardV2 > all five grades render for both themes (golden snapshots) > card-B-light 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" width="750" height="1050" viewBox="0 0 750 1050" font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif">
<defs><linearGradient id="metalB" x1="0" y1="0" x2="1" y2="1">
<stop offset="0%" stop-color="#5c636b" />
<stop offset="28%" stop-color="#eef2f6" />
<stop offset="52%" stop-color="#8a939e" />
<stop offset="76%" stop-color="#ffffff" />
<stop offset="100%" stop-color="#6b7280" />
</linearGradient><linearGradient id="gemGrad" x1="0" y1="0" x2="1" y2="1">
<stop offset="0%" stop-color="#d8dee6" />
<stop offset="50%" stop-color="#8a939e" />
<stop offset="100%" stop-color="#5c636b" />
</linearGradient>
<linearGradient id="plateGrad" x1="0" y1="0" x2="0" y2="1">
<stop offset="0%" stop-color="#f6f8fa" />
<stop offset="100%" stop-color="#ffffff" />
</linearGradient>
<clipPath id="cardClip"><rect x="0" y="0" width="750" height="1050" rx="36" /></clipPath>
<filter id="cardGrain" x="0%" y="0%" width="100%" height="100%">
<feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7" stitchTiles="stitch" result="n" />
<feColorMatrix in="n" type="saturate" values="0" result="g" />
<feComponentTransfer in="g"><feFuncA type="linear" slope="0.5" /></feComponentTransfer>
</filter></defs>
<rect x="0" y="0" width="750" height="1050" fill="#ffffff" rx="36" />
<g clip-path="url(#cardClip)"><rect x="0" y="0" width="750" height="1050" filter="url(#cardGrain)" opacity="0.038" /></g>
<rect x="7" y="7" width="736" height="1036" rx="30" fill="none" stroke="#3d434b" stroke-width="1.5" />
<rect x="11" y="11" width="728" height="1028" rx="26" fill="none" stroke="url(#metalB)" stroke-width="7" />
<rect x="15" y="15" width="720" height="1020" rx="22" fill="none" stroke="#000000" stroke-width="1" stroke-opacity="0.35" />
<rect x="16.5" y="16.5" width="717" height="1017" rx="21" fill="none" stroke="#ffffff" stroke-width="1" stroke-opacity="0.5" />
<line x1="46" y1="9" x2="704" y2="9" stroke="#ffffff" stroke-opacity="0.3" stroke-width="1" />
<rect x="28" y="64" width="560" height="82" rx="14" fill="url(#plateGrad)" />
