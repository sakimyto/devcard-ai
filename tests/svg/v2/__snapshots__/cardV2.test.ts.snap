<line x1="42" y1="65.5" x2="574" y2="65.5" stroke="#ffffff" stroke-opacity="0.1" stroke-width="1" />
<text x="44" y="84" font-size="16" fill="#586069" font-weight="600" text-anchor="start" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif">AI BUILDER</text>
<text x="44" y="128" font-size="42" fill="#24292e" font-weight="bold" text-anchor="start" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif">testuser</text>
