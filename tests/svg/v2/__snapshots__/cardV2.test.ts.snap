<stop offset="0%" stop-color="#ff6ec7" />
<stop offset="35%" stop-color="#ffc36e" />
<stop offset="65%" stop-color="#6ef3ff" />
<stop offset="100%" stop-color="#a06eff" />
</linearGradient></defs>
<rect x="0" y="0" width="750" height="1050" fill="#0d1117" rx="36" />
<g clip-path="url(#cardClip)"><rect x="0" y="0" width="750" height="1050" filter="url(#cardGrain)" opacity="0.038" /></g>
<rect x="7" y="7" width="736" height="1036" rx="30" fill="none" stroke="#3a1d6e" stroke-width="1.5" />
<rect x="11" y="11" width="728" height="1028" rx="26" fill="none" stroke="url(#holoGrad)" stroke-width="7" />
<rect x="15" y="15" width="720" height="1020" rx="22" fill="none" stroke="#000000" stroke-width="1" stroke-opacity="0.35" />
<rect x="16.5" y="16.5" width="717" height="1017" rx="21" fill="none" stroke="#ffffff" stroke-width="1" stroke-opacity="0.5" />
<line x1="46" y1="9" x2="704" y2="9" stroke="#ffffff" stroke-opacity="0.3" stroke-width="1" />
<rect x="11" y="11" width="728" height="1028" rx="26" fill="none" stroke="#ffffff" stroke-width="7" filter="url(#holoFoil)" opacity="0.4" />
<g clip-path="url(#frameClip)">
<rect x="-260" y="0" width="200" height="1050" fill="url(#shineGrad)" transform="skewX(-18)">
<animate attributeName="x" from="-260" to="1010" dur="5s" repeatCount="indefinite" />
</rect>
</g>
